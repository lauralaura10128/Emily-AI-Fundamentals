# Example configuration for supabase/upload.py.
#
# These are read from the ENVIRONMENT, not from this file. Copy the values
# into your shell (or into a .env file and source it -- .env is git-ignored):
#
#   export SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
#   export SUPABASE_KEY="your-service_role-key"
#
# Both are in Supabase under Dashboard -> Project Settings -> API.

# Your project's REST endpoint.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The SECRET service_role key. Server-side only: it bypasses Row Level
# Security. Never commit it, and never put it in a browser page.
# The explorer (index.html) uses the separate *publishable* key instead,
# which is safe to expose because the books table is read-only via RLS.
SUPABASE_KEY=your-service_role-key
